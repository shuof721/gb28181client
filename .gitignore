# build
/bin/
*.exe
*.test
*.out

# logs
*.log
*.err
dev.log
dev.err
plat.log
plat.err

# data storage
data/**/*.tmp

# assets：默认不入库大媒体/缓存，仅白名单示例文件
# 之后往 assets 里放 3.mp4、4.mp4 等都不会被 git 跟踪
assets/*
!assets/demo.mp4
!assets/test.h264

# 若示例旁生成了抽流缓存，再排除一次
assets/*.cache
assets/*.h264.v*.cache

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
